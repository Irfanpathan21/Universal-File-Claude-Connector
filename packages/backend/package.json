{
  "name": "@uft/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Universal File Toolkit — Fastify REST API Backend",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uft/shared": "workspace:*",
    "fastify": "^4.28.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "dotenv": "^16.4.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "vitest": "^2.0.0",
    "rimraf": "^6.0.0",
    "@types/node": "^22.0.0"
  }
}
