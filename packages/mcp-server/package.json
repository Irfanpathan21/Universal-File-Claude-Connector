{
  "name": "@uft/mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Universal File Toolkit — MCP Server",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "uft-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:sse": "node dist/index.js --sse",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uft/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0",
    "rimraf": "^6.0.0",
    "@types/node": "^22.0.0"
  }
}
